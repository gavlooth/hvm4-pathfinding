// All-Pairs Shortest Paths (APSP) - Bend-optimized v2
// 
// Patterns applied from alg_closure_v2:
//   (1) Binary trees via <> for lists
//   (2) DUP memoization with ! for shared computations
//   (3) Recursive param reuse with & prefix
//
// Based on tropical semiring matrix multiplication
// D^(2^k) computes shortest paths of length <= 2^k
// Repeated squaring: log(n) iterations for n-node graph

@INF = 999

// ---- Min operation with DUP pattern ----

@min = λ&a. λ&b. λ{0: b; λk. a}(a < b)

// ---- List indexing with binary tree traversal ----

@nth = λ&i. λlist. λ{
  []: @INF;
  <>: λ&h. λ&t. λ{0: h; λk. @nth(i - 1)(t)}(i)
}(list)

// ---- Tropical dot product: min_k(A[i,k] + B[k,j]) ----
// Apply DUP memoization pattern for shared A and B

@dot = λ&A. λ&B. λ&N. λ&i. λ&j. λ&k. λ&rem.
  λ{
    0: @INF;
    λr.
      ! &a_ik = @nth(i * N + k)(A);
      ! &b_kj = @nth(k * N + j)(B);
      ! &term = a_ik + b_kj;
      ! &rest = @dot(A)(B)(N)(i)(j)(k + 1)(rem - 1);
      @min(term)(rest)
  }(rem)

// ---- Build result matrix cell by cell (flat list) ----
// Apply binary tree construction with <>

@build_cells = λ&A. λ&B. λ&N. λ&idx. λ&rem.
  λ{
    0: [];
    λr.
      ! &i = idx / N;
      ! &j = idx % N;
      ! &val = @dot(A)(B)(N)(i)(j)(0)(N);
      val <> @build_cells(A)(B)(N)(idx + 1)(rem - 1)
  }(rem)

@mat_mul = λ&A. λ&B. λ&N.
  @build_cells(A)(B)(N)(0)(N * N)

// ---- Element-wise min of two flat matrices ----
// Apply recursive param reuse pattern

@mat_min = λlist_a. λlist_b. λ{
  []: [];
  <>: λ&ah. λ&at. λ{
    []: ah <> at;
    <>: λ&bh. λ&bt.
      ! &val = @min(ah)(bh);
      val <> @mat_min(at)(bt)
  }(list_b)
}(list_a)

// ---- Repeated squaring for APSP ----
// Apply DUP memoization for intermediate results

@closure = λ&iters. λ&D. λ&N.
  λ{
    0: D;
    λk.
      ! &D2 = @mat_mul(D)(D)(N);
      ! &Dnew = @mat_min(D)(D2);
      @closure(iters - 1)(Dnew)(N)
  }(iters)

// ---- Reshape flat list → list of rows ----
// Apply binary tree pattern for output formatting

@take = λ&n. λlist. λ{
  []: [];
  <>: λ&h. λ&t. λ{0: []; λk. h <> @take(n - 1)(t)}(n)
}(list)

@drop = λ&n. λ&list.
  λ{
    0: list;
    λk. λ{[]: []; <>: λh. λ&t. @drop(n - 1)(t)}(list)
  }(n)

@reshape = λ&N. λ&rows. λ&list.
  λ{
    0: [];
    λk.
      ! &row = @take(N)(list);
      ! &rest = @drop(N)(list);
      row <> @reshape(N)(rows - 1)(rest)
  }(rows)

// ---- Test graph (4 nodes, weighted directed) ----
// 0->1: 4, 0->3: 10
// 1->2: 3
// 2->3: 1
// Expected APSP: 0->2 = 7 (via 1), 0->3 = 8 (via 1->2->3, beats direct 10)

@dist = 
  0 <> 4 <> @INF <> 10 <> 
  @INF <> 0 <> 3 <> @INF <> 
  @INF <> @INF <> 0 <> 1 <> 
  @INF <> @INF <> @INF <> 0 <> []

@main =
  ! &result = @closure(2)(@dist)(4);
  @reshape(4)(4)(result)

// Expected output:
// [[0, 4, 7, 8],
//  [999, 0, 3, 4],
//  [999, 999, 0, 1],
//  [999, 999, 999, 0]]
