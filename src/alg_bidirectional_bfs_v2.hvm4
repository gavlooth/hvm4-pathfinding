// Bidirectional BFS v2 - Using Bend patterns
// 
// Patterns applied:
// (1) Binary trees via `<>` constructor
// (2) DUP memoization with `!` for reused values
// (3) Recursive parameter reuse with `&` prefix
//
// Graph (7 nodes, undirected, unweighted):
//   0 -- 1, 0 -- 3
//   1 -- 2
//   2 -- 3
//   3 -- 4, 3 -- 6
//   4 -- 5
//   5 -- 6
//
// Shortest path from 0 to 6: 0 -> 3 -> 6 = distance 2

// ---- adjacency: node -> list of neighbors ----

@adj = λ{
  0: 1 <> 3 <> [];
  1: 0 <> 2 <> [];
  2: 1 <> 3 <> [];
  3: 0 <> 2 <> 4 <> 6 <> [];
  4: 3 <> 5 <> [];
  5: 4 <> 6 <> [];
  6: 3 <> 5 <> [];
  λn. []
}

// ---- member(x, xs): is x in list? returns 0 or 1 ----

@member = λ&x. λlist. λ{
  []: 0;
  <>: λ&h. λ&t. λ{
    0: @member(x)(t);
    λk. 1
  }(h == x)
}(list)

// ---- any_in(xs, ys): does any element of xs appear in ys? ----

@any_in = λ&ys. λxs. λ{
  []: 0;
  <>: λ&h. λ&t.
    ! &mem = @member(h)(ys);
    λ{
      0: @any_in(ys)(t);
      λk. 1
    }(mem)
}(xs)

// ---- append(xs, ys): concatenate two lists ----

@append = λxs. λ&ys. λ{
  []: ys;
  <>: λh. λ&t. h <> @append(t)(ys)
}(xs)

// ---- concat_map(f, xs): flatmap f over xs, concatenating results ----

@concat_map = λ&f. λxs. λ{
  []: [];
  <>: λ&h. λ&t.
    ! &fh = f(h);
    ! &rest = @concat_map(f)(t);
    @append(fh)(rest)
}(xs)

// ---- expand(frontier): given a list of nodes, return all their neighbors ----

@expand = λfrontier. @concat_map(@adj)(frontier)

// ---- bfs: bidirectional BFS main loop ----
// fwd = forward frontier (list of nodes)
// bwd = backward frontier (list of nodes)
// dist = current total distance (sum of forward + backward expansions)
// max = maximum distance before giving up

@bfs = λ&fwd. λ&bwd. λ&dist. λ&max.
  λ{
    0:
      ! &intersection = @any_in(bwd)(fwd);
      λ{
        0:
          ! &new_fwd = @expand(fwd);
          ! &next_dist = dist + 1;
          @bfs(bwd)(new_fwd)(next_dist)(max);
        λk. dist
      }(intersection);
    λk. 999
  }(dist > max)

@main = 
  ! &start = 0 <> [];
  ! &goal = 6 <> [];
  @bfs(start)(goal)(0)(10)

// Expected: 2
