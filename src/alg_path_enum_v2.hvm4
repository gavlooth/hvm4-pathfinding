// Path Enumeration - using Bend patterns from closure_v2
// 
// Three key patterns applied:
// 1. Binary trees via `<>` - Replace SUP with explicit list cons/append
// 2. DUP memoization with `!` - Share computed sublists across branches  
// 3. Recursive param reuse - Thread `weight` accumulator with `&` for sharing
//
// Translation from SUP to explicit lists:
//   Before: &A{2 + explore(1), 3 + explore(2)}  (superposition)
//   After:  ! &path1 = explore(1)(w+2);          (DUP binding)
//           ! &path2 = explore(2)(w+3);          (second branch)
//           append(path1)(path2)                 (binary tree merge)

// ---- List operations (from closure_v2) ----

@append = λxs. λ&ys. λ{
  []: ys;
  <>: λh. λ&t. h <> @append(t)(ys)
}(xs)

// ---- Explore graph from node, accumulating weight ----
// Returns list of all path weights from node to destination (5)
// Uses binary tree structure (<>) instead of SUP

@explore = λnode. λ&weight. λ{
  0:
    ! &path1 = @explore(1)(weight + 2);
    ! &path2 = @explore(2)(weight + 3);
    @append(path1)(path2);
  1:
    ! &path1 = @explore(3)(weight + 1);
    ! &path2 = @explore(4)(weight + 4);
    @append(path1)(path2);
  2:
    ! &path1 = @explore(3)(weight + 5);
    ! &path2 = @explore(4)(weight + 2);
    @append(path1)(path2);
  3: @explore(5)(weight + 3);
  4: @explore(5)(weight + 1);
  5: weight <> [];
  λn. []
}(node)

@main = @explore(0)(0)

// Expected: [6, 7, 11, 6]
// Paths:
//   0->1->3->5 : 2+1+3 = 6
//   0->1->4->5 : 2+4+1 = 7
//   0->2->3->5 : 3+5+3 = 11
//   0->2->4->5 : 3+2+1 = 6
