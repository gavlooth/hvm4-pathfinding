// Bidirectional BFS — trie-based visited sets (Q4 radix-4 trie)
//
// Graph (7 nodes, undirected, unweighted):
//   0--1, 0--3, 1--2, 2--3, 3--4, 3--6, 4--5, 5--6
// Shortest path 0→6: 0->3->6 = distance 2
//
// Visited tries store BFS depth (not boolean).
// All trie operations are linear (no DUP on tries).
// Frontiers are cons-lists; DUP'd for check+next iteration.

@INF = 999999
@DEPTH = 2

// ---- Q4 radix-4 trie (linear get + set) ----

@q4_get_lin = λ&key. λ&depth. λ{
  #QE: #P{@INF, #QE{}};
  #QL: λ&val. #P{val, #QL{val}};
  #Q: λc0. λc1. λc2. λc3.
    ! slot = key % 4; ! next = key / 4; ! nd = depth - 1;
    @q4_get_lin_Q(slot, next, nd, c0, c1, c2, c3)}

@q4_get_lin_Q = λ{
  0: λnext. λnd. λc0. λc1. λc2. λc3.
    λ{#P: λval. λnew_c0. #P{val, #Q{new_c0, c1, c2, c3}}}(@q4_get_lin(next, nd, c0));
  1: λnext. λnd. λc0. λc1. λc2. λc3.
    λ{#P: λval. λnew_c1. #P{val, #Q{c0, new_c1, c2, c3}}}(@q4_get_lin(next, nd, c1));
  2: λnext. λnd. λc0. λc1. λc2. λc3.
    λ{#P: λval. λnew_c2. #P{val, #Q{c0, c1, new_c2, c3}}}(@q4_get_lin(next, nd, c2));
  λn. λnext. λnd. λc0. λc1. λc2. λc3.
    λ{#P: λval. λnew_c3. #P{val, #Q{c0, c1, c2, new_c3}}}(@q4_get_lin(next, nd, c3))}

@q4_set = λ&key. λ&val. λ&depth. λ{
  #QL: λold. #QL{val};
  #QE: λ{0: #QL{val}; λn.
    ! slot = key % 4; ! next = key / 4; ! nd = depth - 1;
    @q4_set_QE(slot, next, val, nd)}(depth);
  #Q: λc0. λc1. λc2. λc3.
    ! slot = key % 4; ! next = key / 4; ! nd = depth - 1;
    @q4_set_Q(slot, next, val, nd, c0, c1, c2, c3)}

@q4_set_QE = λ{
  0: λnext. λval. λnd. #Q{@q4_set(next, val, nd, #QE{}), #QE{}, #QE{}, #QE{}};
  1: λnext. λval. λnd. #Q{#QE{}, @q4_set(next, val, nd, #QE{}), #QE{}, #QE{}};
  2: λnext. λval. λnd. #Q{#QE{}, #QE{}, @q4_set(next, val, nd, #QE{}), #QE{}};
  λn. λnext. λval. λnd. #Q{#QE{}, #QE{}, #QE{}, @q4_set(next, val, nd, #QE{})}}

@q4_set_Q = λ{
  0: λnext. λval. λnd. λc0. λc1. λc2. λc3. #Q{@q4_set(next, val, nd, c0), c1, c2, c3};
  1: λnext. λval. λnd. λc0. λc1. λc2. λc3. #Q{c0, @q4_set(next, val, nd, c1), c2, c3};
  2: λnext. λval. λnd. λc0. λc1. λc2. λc3. #Q{c0, c1, @q4_set(next, val, nd, c2), c3};
  λn. λnext. λval. λnd. λc0. λc1. λc2. λc3. #Q{c0, c1, c2, @q4_set(next, val, nd, c3)}}

// ---- min helper ----

@min = λ&a. λ&b. λ{0: b; λn. a}(a < b)

// ---- hardcoded graph adjacency ----

@deg = λ{0: 2; 1: 2; 2: 2; 3: 4; 4: 2; 5: 2; 6: 2; λn. 0}

@nbr = λ{
  0: λ{0: 1; λn. 3};
  1: λ{0: 0; λn. 2};
  2: λ{0: 1; λn. 3};
  3: λ{0: 0; 1: 2; 2: 4; λn. 6};
  4: λ{0: 3; λn. 5};
  5: λ{0: 4; λn. 6};
  6: λ{0: 3; λn. 5};
  λn. λi. 0
}

// ---- expand_nbrs: expand neighbors of node u (i..deg) ----
// Top-level MAT helpers avoid inline MAT capturing trie variables.

@expand_nbrs = λ&u. λ&i. λ&deg. λfront. λ&d. λvis.
  @enb_check(i < deg, u, i, deg, front, d, vis)

@enb_check = λ{
  0: λu. λi. λdeg. λfront. λd. λvis. #P{front, vis};
  λn. λ&u. λ&i. λdeg. λfront. λ&d. λvis.
    ! &v = @nbr(u, i);
    λ{#P: λ&vd. λvis2.
      @enb_cond(vd < @INF, u, i, deg, front, d, v, vis2)
    }(@q4_get_lin(v, @DEPTH, vis))
}

@enb_cond = λ{
  0: λu. λi. λdeg. λfront. λ&d. λ&v. λvis.
    @expand_nbrs(u, i + 1, deg, v <> front, d, @q4_set(v, d, @DEPTH, vis));
  λm. λu. λi. λdeg. λfront. λd. λv. λvis.
    @expand_nbrs(u, i + 1, deg, front, d, vis)
}

// ---- expand_all: expand all nodes in old frontier ----

@expand_all = λ{
  []: λnew_front. λd. λvis. #P{new_front, vis};
  <>: λ&u. λrest. λnew_front. λ&d. λvis.
    λ{#P: λfront2. λvis2.
      @expand_all(rest, front2, d, vis2)
    }(@expand_nbrs(u, 0, @deg(u), new_front, d, vis))
}

// ---- check_meet: check if frontier nodes appear in opposite visited ----

@check_meet = λ{
  []: λd. λbest. λopp. #P{best, opp};
  <>: λ&v. λrest. λ&d. λ&best. λopp.
    λ{#P: λ&od. λopp2.
      @cm_cond(od < @INF, rest, d, best, od, opp2)
    }(@q4_get_lin(v, @DEPTH, opp))
}

@cm_cond = λ{
  0: λrest. λd. λbest. λod. λopp. @check_meet(rest, d, best, opp);
  λm. λrest. λ&d. λbest. λod. λopp. @check_meet(rest, d, @min(best, d + od), opp)
}

// ---- bfs_loop: main bidirectional BFS loop ----

@bfs_loop = λ&fd. λ&bd. λ&best. λff. λbf. λfv. λbv.
  ! &nfd = fd + 1;
  ! &nbd = bd + 1;
  λ{#P: λ&nff. λfv2.
    λ{#P: λ&bst2. λbv2.
      λ{#P: λ&nbf. λbv3.
        λ{#P: λ&bst3. λfv3.
          @bfs_done(bst3 < @INF, nff, nbf, fv3, bv3, nfd, nbd, bst3)
        }(@check_meet(nbf, nbd, bst2, fv2))
      }(@expand_all(bf, [], nbd, bv2))
    }(@check_meet(nff, nfd, best, bv))
  }(@expand_all(ff, [], nfd, fv))

@bfs_done = λ{
  0: λff. λbf. λfv. λbv. λfd. λbd. λbst.
    @bfs_mt(ff, bf, fv, bv, fd, bd);
  λm. λff. λbf. λfv. λbv. λfd. λbd. λbst. bst
}

@bfs_mt = λ{
  []: λbf. λfv. λbv. λfd. λbd. @INF;
  <>: λh. λt. λbf. λfv. λbv. λfd. λbd.
    @bfs_mt2(bf, h <> t, fv, bv, fd, bd)
}

@bfs_mt2 = λ{
  []: λff. λfv. λbv. λfd. λbd. @INF;
  <>: λh2. λt2. λff. λfv. λbv. λfd. λbd.
    @bfs_loop(fd, bd, @INF, ff, h2 <> t2, fv, bv)
}

// ---- main ----

@main =
  ! fv = @q4_set(0, 0, @DEPTH, #QE{});
  ! bv = @q4_set(6, 0, @DEPTH, #QE{});
  @bfs_loop(0, 0, @INF, [0], [6], fv, bv)
//2
