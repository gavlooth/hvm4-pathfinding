// Bellman-Ford Shortest Path - using Bend patterns
// 
// Pattern: Edge relaxation with distance tracking
// Note: Uses list prepending for updates (lookup finds first/latest match)

// ---- Weighted Edge: Church triple ----

@Edge = λsrc. λdst. λweight. λf. f(src)(dst)(weight)

@get_src = λe. e(λs. λd. λw. s)
@get_dst = λe. e(λs. λd. λw. d)
@get_weight = λe. e(λs. λd. λw. w)

// ---- Distance entry: (node, dist) ----

@Dist = λnode. λdist. λf. f(node)(dist)

@get_node = λd. d(λn. λdst. n)
@get_value = λd. d(λn. λdst. dst)

// ---- Constants ----

@INF = 999999

// ---- Lookup distance for node ----
// DUP memoization with ! bindings

@lookup = λ&node. λdists. λ{
  []: @INF;
  <>: λ&entry. λ&rest.
    ! &n = @get_node(entry);
    λ{
      0: @lookup(node)(rest);
      λk. @get_value(entry)
    }(n == node)
}(dists)

// ---- Min helper ----

@min = λ&a. λ&b. λ{0: b; λk. a}(a < b)

// ---- Relax single edge ----
// Recursive function with param reuse (&)

@relax_edge = λ&edge. λ&dists.
  ! &u = @get_src(edge);
  ! &v = @get_dst(edge);
  ! &w = @get_weight(edge);
  ! &dist_u = @lookup(u)(dists);
  ! &dist_v = @lookup(v)(dists);
  ! &new_dist = dist_u + w;
  ! &better = @min(new_dist)(dist_v);
  @Dist(v)(better)

// ---- Relax all edges, collect results ----
// Binary tree construction via <>

@relax_all = λ&dists. λedges. λ{
  []: [];
  <>: λ&edge. λ&rest.
    ! &relaxed = @relax_edge(edge)(dists);
    ! &tail = @relax_all(dists)(rest);
    relaxed <> tail
}(edges)

// ---- Append lists ----

@append = λxs. λ&ys. λ{
  []: ys;
  <>: λh. λ&t. h <> @append(t)(ys)
}(xs)

// ---- One iteration of edge relaxation ----

@iterate = λ&edges. λ&dists.
  ! &new_dists = @relax_all(dists)(edges);
  @append(new_dists)(dists)

// ---- Entry point (manual unroll for 2 iterations) ----

@shortest_paths = λ&edges. λsource.
  ! &init = @Dist(source)(0) <> [];
  ! &after1 = @iterate(edges)(init);
  @iterate(edges)(after1)

// ---- Test graph ----
// 0 --1--> 1 --2--> 2

@test_edges =
  @Edge(0)(1)(1) <> 
  @Edge(1)(2)(2) <> 
  []

@main = @shortest_paths(@test_edges)(0)

// Expected output: list of (node, dist) pairs
// Should contain (2, 3), (1, 1), (0, 0) as latest entries
// Lookup will find the first (latest) match for each node
